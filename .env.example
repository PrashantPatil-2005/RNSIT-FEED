# Copy to .env.local and fill in. Never commit real values.
#
# Public (safe to expose to the browser; access is enforced by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Server-only secrets are NOT used by the app yet. When account deletion is built, the service-role
# key will be read only on the server, under a name WITHOUT the NEXT_PUBLIC_ prefix.
#
# Set to "true" ONLY where the database holds synthetic sample data (local/demo). Pages then label
# all content as sample data. Leave unset in production.
NEXT_PUBLIC_SAMPLE_CONTENT=
#
# Canonical origin of the site, server-only. OAuth redirects are built from it (never from the
# request Host). Must be listed in Supabase Auth's redirect allow-list. Sign-in is disabled if unset.
SITE_URL=http://127.0.0.1:3100
