# Copy to .env.local and fill in. Never commit real values.
#
# Public (safe to expose to the browser; access is enforced by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Server-only secrets are NOT used by the app yet. When account deletion is built, the service-role
# key will be read only on the server, under a name WITHOUT the NEXT_PUBLIC_ prefix.
