{
  "name": "rnsit-feed",
  "version": "0.1.0",
  "private": true,
  "description": "RNSIT FEED web application",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db:pglite": "node supabase/tests/run-local.mjs",
    "test:db": "node supabase/tests/run-supabase.mjs",
    "test:api": "node supabase/tests/api/run-api.mjs",
    "test:smoke": "node scripts/smoke-public.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "test:e2e:submit": "node scripts/e2e-submit.mjs",
    "test:e2e:moderation": "node scripts/e2e-moderation.mjs",
    "db:types": "npx supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "test:e2e:auth": "node scripts/e2e-auth.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mts\"",
    "test:e2e:admin": "node scripts/e2e-admin.mjs",
    "test:e2e:community": "node scripts/e2e-community.mjs",
    "test:e2e:roles": "node scripts/e2e-roles.mjs",
    "test:e2e:team": "node scripts/e2e-team.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
